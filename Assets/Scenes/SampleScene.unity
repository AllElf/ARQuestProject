    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041A\u043E\u043B\u043E\u0431\u043E\u043A \u043F\u043E\u0434\u043E\u0448\u0451\u043B
    \u043A \u043A\u043E\u0440\u0437\u0438\u043D\u0435, \u0433\u0434\u0435 \u043B\u0435\u0436\u0430\u043B\u043E
    \u043A\u0440\u0430\u0441\u043D\u043E\u0435 \u044F\u0431\u043B\u043E\u043A\u043E.\r\n\u041E\u043D
    \u043F\u043E\u0434\u043D\u044F\u043B \u0435\u0433\u043E \u0438 \u0443\u0432\u0438\u0434\u0435\u043B
    \u043F\u043E\u0434 \u043D\u0438\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E
    \u0437\u0430\u043F\u0438\u0441\u043A\u0443.\r\n\u0412 \u0437\u0430\u043F\u0438\u0441\u043A\u0435
    \u0431\u044B\u043B\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u043E \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u0447\u043D\u043E\u0435
    \u0441\u043B\u043E\u0432\u043E."
