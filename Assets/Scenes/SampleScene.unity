  m_Text: "\u041A\u043E\u043B\u043E\u0431\u043E\u043A \u0443\u0432\u0438\u0434\u0435\u043B
    \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
    \u043A\u043E\u0440\u0437\u0438\u043D\u0443 \u0441 \u0430\u0440\u043E\u043C\u0430\u0442\u043D\u044B\u043C
    \u0445\u043B\u0435\u0431\u043E\u043C.\n\u041E\u043D \u043F\u043E\u0434\u043E\u0448\u0451\u043B
    \u043F\u043E\u0431\u043B\u0438\u0436\u0435, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u0443\u044E \u043A\u043E\u0440\u043E\u0447\u043A\u0443.\n\u0412\u043E\u0437\u043B\u0435
    \u043A\u043E\u0440\u0437\u0438\u043D\u044B \u043B\u0435\u0436\u0430\u043B\u0430
    \u0437\u0430\u043F\u0438\u0441\u043A\u0430 \u0441 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u043E\u0439."
